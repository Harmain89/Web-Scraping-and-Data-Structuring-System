    {
      "id": "0d3e6a49-ee1a-4752-b13a-553bf28c7a50",
      "name": "Evaluate Lifecycle Stages",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        192
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "\nconst rows = $input.all();\nconst now = Date.now();\nconst results = [];\n\nfor (const item of rows) {\n  const b = item.json;\n  if (!b || !b.booking_id || b.status === 'cancelled') continue;\n\n  const startMs = new Date(b.requested_start).getTime();\n  const endMs = new Date(b.requested_end).getTime();\n  if (isNaN(startMs) || isNaN(endMs)) continue;\n\n  const msUntilStart = startMs - now;\n  const hoursUntilStart = msUntilStart / (1000 * 60 * 60);\n  const minutesUntilStart = msUntilStart / (1000 * 60);\n  const msSinceEnd = now - endMs;\n  const minutesSinceEnd = msSinceEnd / (1000 * 60);\n\n  // 24-Hour Reminder Window: 23h to 25h ahead\n  if (hoursUntilStart >= 23 && hoursUntilStart <= 25 && !b.reminder_24h_sent) {\n    results.push({\n      json: {\n        ...b,\n        notification_type: 'reminder_24h',\n        reminder_type_label: '24-Hour Reminder'\n      }\n    });\n  }\n  // 1-Hour Reminder Window: 45m to 75m ahead\n  else if (minutesUntilStart >= 45 && minutesUntilStart <= 75 && !b.reminder_1h_sent) {\n    results.push({\n      json: {\n        ...b,\n        notification_type: 'reminder_1h',\n        reminder_type_label: '1-Hour Reminder'\n      }\n    });\n  }\n  // Post-Appointment Follow-up Window: 15m to 180m after meeting\n  else if (minutesSinceEnd >= 15 && minutesSinceEnd <= 180 && !b.follow_up_sent) {\n    results.push({\n      json: {\n        ...b,\n        notification_type: 'follow_up',\n        reminder_type_label: 'Post-Appointment Follow-up'\n      }\n    });\n  }\n}\n\nif (results.length === 0) {\n  return [{ json: { has_notifications: false, notification_type: 'none' } }];\n}\n\nreturn results.map(r => ({\n  json: {\n    ...r.json,\n    has_notifications: true\n  }\n}));\n"
      }
    },
