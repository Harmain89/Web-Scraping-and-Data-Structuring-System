        896,
        288
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "\nconst req = $('Normalize Lifecycle Request').first().json;\nconst rows = $input.all();\nconst booking = (rows.length > 0 && rows[0].json && rows[0].json.booking_id) ? rows[0].json : null;\n\nreturn [{\n  json: {\n    booking_found: booking !== null,\n    booking_id: req.booking_id,\n    action: req.action,\n    new_start: req.new_start,\n    new_end: req.new_end,\n    reason: req.reason,\n    customer_name: booking ? booking.customer_name : null,\n    phone_e164: booking ? booking.phone_e164 : null,\n    email: booking ? booking.email : null,\n    service: booking ? booking.service : null,\n    calendar_event_id: booking ? booking.calendar_event_id : null,\n    current_status: booking ? booking.status : null\n  }\n}];\n"
      }
