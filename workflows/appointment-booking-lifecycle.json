    {
      "id": "aebe1ca9-b2f7-4e3d-bce8-f46a115d62d2",
      "name": "Normalize Lifecycle Request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        384
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "\nconst input = $input.first().json;\nconst data = input.body || input;\n\nconst bookingId = (data.booking_id || '').trim();\nconst action = (data.action || '').trim().toLowerCase();\nconst requestedStart = data.new_requested_start || data.requested_start;\nconst reason = (data.reason || 'Requested by customer').trim();\n\nconst errors = [];\nif (!bookingId) errors.push('booking_id is required.');\nif (!['reschedule', 'cancel'].includes(action)) errors.push('action must be either \"reschedule\" or \"cancel\".');\n\nlet newStart = null;\nlet newEnd = null;\nif (action === 'reschedule') {\n  if (!requestedStart) {\n    errors.push('new_requested_start timestamp is required for rescheduling.');\n  } else {\n    const sDate = new Date(requestedStart);\n    if (isNaN(sDate.getTime())) {\n      errors.push('new_requested_start must be a valid ISO 8601 date.');\n    } else if (sDate.getTime() <= Date.now() + 300000) {\n      errors.push('new_requested_start must be at least 5 minutes in the future.');\n    } else {\n      newStart = sDate.toISOString();\n      newEnd = new Date(sDate.getTime() + 45 * 60000).toISOString();\n    }\n  }\n}\n\nreturn [{\n  json: {\n    is_valid: errors.length === 0,\n    errors: errors,\n    booking_id: bookingId,\n    action: action,\n    new_start: newStart,\n    new_end: newEnd,\n    reason: reason\n  }\n}];\n"
      }
    },
