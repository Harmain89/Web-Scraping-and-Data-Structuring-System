      "id": "6434163a-c4d6-4f11-963d-b57940af719d",
      "name": "Evaluate Reschedule Conflict",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1792,
        288
      ],
      "parameters": {
        "language": "javaScript",
        "jsCode": "\nconst prev = $('Verify Booking Found').first().json;\nconst items = $input.all();\n\nlet isConflict = false;\nfor (const item of items) {\n  const evt = item.json;\n  // Ignore conflict if it is the current appointment's own event\n  if (evt && evt.id && String(evt.id) !== String(prev.calendar_event_id) && evt.status !== 'cancelled' && evt.summary && !evt.error) {\n    isConflict = true;\n  }\n}\n\nreturn [{\n  json: {\n    ...prev,\n    is_reschedule_slot_available: !isConflict\n  }\n}];\n"
      }
    },
